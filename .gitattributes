# Text is UTF-8 with LF; binary content is preserved by automatic detection.
* text=auto eol=lf
*.md text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.jsonl text working-tree-encoding=UTF-8
*.py text working-tree-encoding=UTF-8
*.js text working-tree-encoding=UTF-8
*.mjs text working-tree-encoding=UTF-8
*.cjs text working-tree-encoding=UTF-8
*.ts text working-tree-encoding=UTF-8
*.vue text working-tree-encoding=UTF-8
*.yml text working-tree-encoding=UTF-8
*.yaml text working-tree-encoding=UTF-8
*.toml text working-tree-encoding=UTF-8
*.sh text working-tree-encoding=UTF-8
*.ps1 text working-tree-encoding=UTF-8
# Original frontend and release artifacts retain exact upstream bytes.
frontend/** -text !eol !working-tree-encoding
# Evidence manifests refer to raw file digests; never normalize evidence bytes.
docs/evidence/** -text !eol !working-tree-encoding
# Imported IP list/changelog are source-bound data, not normalized prose.
backend/domains/accounts_cn_ips.txt -text !eol !working-tree-encoding
backend/domains/accounts_upstream_changelog.txt -text !eol !working-tree-encoding
