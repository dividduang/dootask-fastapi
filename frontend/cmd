#!/usr/bin/env node
// Frontend-only commands. Backend deployment lives in ../deploy/README.md.
const {existsSync} = require('node:fs');
const path = require('node:path');
const {spawnSync} = require('node:child_process');

const root = __dirname;
const [command = 'help', ...args] = process.argv.slice(2);
const help = `Usage: node cmd <command> [arguments]

  dev | serve | start     Start the Vite asset development server
  build | prod            Build Web assets for the FastAPI host
  electron [arguments]    Run the Electron build/development tool
  help                    Show this help

Install Web dependencies with npm ci in frontend/.
Electron also requires npm ci in frontend/electron/.
Backend deployment and operations: ../deploy/README.md.
The FastAPI host serves built assets; it does not consume the Vite hot server.
`;

let entry;
let childArgs = args;
let env = process.env;
switch (command) {
    case 'help':
    case '--help':
    case '-h':
        console.log(help);
        process.exit(0);
        break;
    case 'dev':
    case 'serve':
    case 'start':
        entry = path.join(root, 'node_modules/vite/bin/vite.js');
        break;
    case 'build':
    case 'prod':
        entry = path.join(root, 'node_modules/vite/bin/vite.js');
        childArgs = ['build', ...args];
        break;
    case 'electron':
        if (!existsSync(path.join(root, 'electron/node_modules'))) {
            console.error('Install desktop dependencies first: cd frontend/electron && npm ci');
            process.exit(1);
        }
        entry = path.join(root, 'electron/build.js');
        env = {...process.env, BUILD_FRONTEND: args[0] === 'dev' ? 'dev' : 'build'};
        break;
    default:
        console.error(`Unsupported command: ${command}\n${help}`);
        process.exit(2);
}

if (!existsSync(path.join(root, 'node_modules/vite/bin/vite.js'))) {
    console.error('Install Web dependencies first: cd frontend && npm ci');
    process.exit(1);
}
const result = spawnSync(process.execPath, [entry, ...childArgs], {
    cwd: root,
    env,
    stdio: 'inherit',
});
if (result.error) {
    console.error(result.error.message);
}
process.exit(result.status ?? 1);
